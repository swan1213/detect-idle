{
  "name": "detect-idle",
  "productName": "Detect Idle",
  "version": "1.0.0",
  "description": "Freelancer idle detection with push alerts to the client",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron . --role=client",
    "start:client": "electron . --role=client",
    "start:freelancer": "electron . --role=freelancer",
    "dist": "node scripts/build.js",
    "release": "node scripts/build.js --release",
    "icons": "electron scripts/make-icons.js"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "uiohook-napi": "^1.5.5",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.detectidle.app",
    "productName": "Detect Idle",
    "electronVersion": "33.4.11",
    "electronDist": "node_modules/electron/dist",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/uiohook-napi/**"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
